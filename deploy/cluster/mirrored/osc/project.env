# project.env - OSCILLATION project. Sets everything that depends on the project:
#   source ~/CPPxDIC/deploy/cluster/mirrored/osc/project.env      (or: source project.env)
# Silent with PROJECT_QUIET=1. Nothing else is chosen by hand: submit_csv.sh, the frame script and
# the sbatch line use these variables.
_pe_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_pe_g="${GLOBALSCRATCH:-}"
[[ -n "${_pe_g}" ]] || { echo "ERROR: GLOBALSCRATCH is not set (CECI sets it at login)" >&2; return 1; }
export PROJECT_NAME=slip_and_roll_osc
export PROJECT_DIR="${_pe_dir}"                                       # CSV, templates, scripts of the project
export CONFIG_DIR="${_pe_dir}/configs"                                # dic_params.txt, ncorr_params.txt, ...
export FRAME_SCRIPT="${_pe_dir}/frame_oscillation_complete.sh"        # frame windows from MovNo, Relative=2, nbr_osc
export RAW_DIR="${_pe_g}/data/slip_and_roll"                          # raw data of both projects (never renamed)
export DATA_DIR="${_pe_g}/data_staged/${PROJECT_NAME}"                # staged data
export OUTPUT_DIR="${_pe_g}/analysis/${PROJECT_NAME}"                 # results
unset _pe_dir _pe_g
[[ -n "${PROJECT_QUIET:-}" ]] || echo "project=${PROJECT_NAME}  PROJECT_DIR=${PROJECT_DIR}  DATA_DIR=${DATA_DIR}  OUTPUT_DIR=${OUTPUT_DIR}"
