# project.env - TEMPLATE of a project. Copy this folder, then edit the two lines marked EDIT:
#   cp -r ~/CPPxDIC/deploy/cluster/mirrored/template ~/CPPxDIC/deploy/cluster/mirrored/<my_project>
#   source ~/CPPxDIC/deploy/cluster/mirrored/<my_project>/project.env
# Silent with PROJECT_QUIET=1. submit_csv.sh, the frame script and the sbatch line use these variables.
_pe_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_pe_g="${GLOBALSCRATCH:-}"
[[ -n "${_pe_g}" ]] || { echo "ERROR: GLOBALSCRATCH is not set (CECI sets it at login)" >&2; return 1; }
export PROJECT_NAME=my_project                                        # EDIT 1: project name (names the staged-data and results folders)
export PROJECT_DIR="${_pe_dir}"                                       # CSV, templates, scripts of the project
export CONFIG_DIR="${_pe_dir}/configs"                                # dic_params.txt, ncorr_params.txt, ...
export FRAME_SCRIPT="$(cd "${_pe_dir}/../.." && pwd)/frame_standard_complete.sh"   # frame windows from the movement numbers (MovNo) of the protocol
export RAW_DIR="${_pe_g}/data/my_dataset"                          # EDIT 2: dataset folder, raw data: <RAW_DIR>/<subject>/{vid,protocol,...}
export DATA_DIR="${_pe_g}/data_staged/${PROJECT_NAME}"                # staged data
export OUTPUT_DIR="${_pe_g}/analysis/${PROJECT_NAME}"                 # results
unset _pe_dir _pe_g
[[ -n "${PROJECT_QUIET:-}" ]] || echo "project=${PROJECT_NAME}  PROJECT_DIR=${PROJECT_DIR}  DATA_DIR=${DATA_DIR}  OUTPUT_DIR=${OUTPUT_DIR}"
